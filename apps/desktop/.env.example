# ================================================================
# Bazaar POS — Desktop Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ================================================================

# ----------------------------------------------------------------
# Supabase (free tier)
# Project: https://supabase.com/dashboard/project/<your-project-id>
# ----------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------
# PowerSync (free tier)
# Instance: https://app.powersync.com/project/<your-instance-id>
# ----------------------------------------------------------------
VITE_POWERSYNC_URL=https://your-instance-id.powersync.journeyapps.com

# ----------------------------------------------------------------
# Storage Engine Override
# Unset (default) = PowerSyncStorageEngine (offline-first + cloud sync)
# 'legacy'        = Original localStorage engine (emergency rollback)
# ----------------------------------------------------------------
# VITE_STORAGE=legacy
